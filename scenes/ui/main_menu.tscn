[node name="FlightManualDialog" type="AcceptDialog" parent="."]
title = "FLIGHT MANUAL — TACTICAL CONTROLS"
size = Vector2i(540, 420)
dialog_text = "TACTICAL FLIGHT CONTROLS:
• W / S or UP / DOWN: Cyclic Thrust Forward / Air Braking
• A / D or LEFT / RIGHT: Rudder Yaw Heading Turn
• Q / E: Lateral Strafe Left / Right
• SPACE or SHIFT: Collective Altitude Climb
• CTRL or C: Collective Altitude Descend
• MOUSE: High-Precision Chin Turret Aiming
• LEFT CLICK or J: Fire Primary Selected Weapon
• RIGHT CLICK: Paint 6-Lock Salvo (Release to Launch)
• F: Countermeasure Flare Decoy Deployment
• ALT or X: Evasive Thruster Dash
• V or G: Devastation Super Activation
• 1 - 4 or SCROLL: Weapon Arsenal Selection
• R: Manual Weapon Reload
• ESC or P: Tactical Mission Pause"
